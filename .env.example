# .env.example (This file GOES to Git)

# Database configuration
POSTGRES_USER=your_user_here
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=autoshift_db
DB_HOST=db
DB_PORT=5432

# URL for the application to connect to the DB
DATABASE_URL=postgresql://user:password@db:5432/dbname

# External APIs
GOOGLE_API_KEY=your_google_api_key_here

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
# Sliding session: days of inactivity before the user must log in again
ACCESS_TOKEN_EXPIRE_DAYS=90

# Environment Mode (production / development)
ENVIRONMENT=development

# Email Settings for Password Reset
SMTP_SERVER=mail.your-server.de
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your_secure_password_here
SENDER_EMAIL=your-email@example.com
FRONTEND_URL=http://localhost:5173

# Scheduling engine: seconds per auto-assign run (keep below the web client's 300 s timeout) and CP-SAT workers
SOLVER_MAX_SECONDS=60
SOLVER_NUM_WORKERS=8
