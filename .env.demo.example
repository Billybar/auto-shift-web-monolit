# .env.demo.example (This file GOES to Git)
# Copy to .env.demo on the server, next to docker-compose.demo.yml. Never reuse production values here.

# Port on the server's localhost that the Cloudflare Tunnel's public hostname for demo.autoshift.co.il
# points at (service http://localhost:8001). Must differ from production's HOST_PORT
DEMO_HOST_PORT=8001

# Demo database (its own container; wiped on every demo deploy)
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=autoshift_demo
DB_HOST=demo-db
DB_PORT=5432
DATABASE_URL=postgresql://demo_user:change_me@demo-db:5432/autoshift_demo

# Security: a different key from production, so a demo token is never valid on autoshift.co.il.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_new_key_here
ALGORITHM=HS256
# Sandboxes live for DEMO_SANDBOX_TTL_HOURS anyway
ACCESS_TOKEN_EXPIRE_DAYS=2

ENVIRONMENT=production

# Demo mode: one-click private sandboxes, deleted after the TTL
DEMO_MODE=true
DEMO_SANDBOX_TTL_HOURS=48
DEMO_MAX_SANDBOXES_PER_IP_PER_HOUR=5
DEMO_MAX_ACTIVE_SANDBOXES=1000

# The per-IP limit reads the visitor's IP from this header. Cloudflare always sets CF-Connecting-IP
# and overwrites any value the visitor sent (X-Forwarded-For can be faked through Cloudflare).
DEMO_CLIENT_IP_HEADER=CF-Connecting-IP

# Auto-assign: the same workers as production. Below about 6 workers CP-SAT can't prove a schedule
# optimal, so every run would last the full time limit (8 workers: about 0.3 s on the demo data).
# The time limit is only a safety cap for unusually hard cases a visitor builds.
SOLVER_MAX_SECONDS=15
SOLVER_NUM_WORKERS=8

# No SMTP settings: demo users have no real mailbox, so password reset is off in practice
FRONTEND_URL=https://demo.autoshift.co.il
