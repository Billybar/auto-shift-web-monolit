{
  "expo": {
    "name": "Auto Shift",
    "slug": "auto-shift-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/icon-1024.png",
    "scheme": "autoshift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "assets/images/icon-1024.png",
      "bundleIdentifier": "il.co.autoshift",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "il.co.autoshift",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "assets/images/play-store-icon-512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "assets/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5213f61-bba8-41bd-83b1-eadb9dd079c4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b5213f61-bba8-41bd-83b1-eadb9dd079c4"
    }
  }
}
